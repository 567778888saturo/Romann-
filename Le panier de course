<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Panier de Courses</title>
  <style>
  
    body { font-family: Arial; padding: 20px; }
    .article { margin-bottom: 10px; }
    #panier { margin-top: 20px; }
    button { margin-left: 5px; }
  </style>
</head>
<body>

  <h1>Simulateur de Panier de Courses</h1>

  <div class="article">
    <span>le lait - 1000frs</span>
    <button onclick="ajouterArticle('le lait', 1000)">Ajouter</button>
  </div>
  <div class="article">
    <span>Pain - 150frs</span>
    <button onclick="ajouterArticle('Pain',150 )">Ajouter</button>
  </div>
  <div class="article">
    <span>le beignets - 50frs</span>
    <button onclick="ajouterArticle('beignet', 50)">Ajouter</button>
  </div>

  <h2>le panier</h2>
  <ul id="panier"></ul>
  <p>Total: <span id="total">0</span> frs</p>

  <script>
    let panier = [];
    function ajouterArticle(nom, prix) {
      panier.push({ nom, prix });
      afficherPanier();
    }

    function supprimerArticle(index) {
      panier.splice(index, 1);
      afficherPanier();
    }

    function afficherPanier() {
      const ul = document.getElementById('panier');
      ul.innerHTML = '';
      let total = 0;
      panier.forEach((item, index) => {
        total += item.prix;
        const li = document.createElement('li');
        li.textContent = `${item.nom} - ${item.prix}frs`;
        const btn = document.createElement('button');
        btn.textContent = 'Supprimer';
        btn.onclick = () => supprimerArticle(index);
        li.appendChild(btn);
        ul.appendChild(li);
      });
      document.getElementById('total').textContent = total.toFixed(2);
    }
  </script>

</body>
</html>
